# monitor-cambio/.env.example
# Copie para .env e ajuste. Nunca versione o .env.
POSTGRES_USER=cambio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cambio
# Dentro do Docker o host é "db"; rodando local, use localhost:5435
DATABASE_URL=postgresql+psycopg://cambio:troque-esta-senha@db:5432/cambio
MOEDAS=USD,EUR
LOG_LEVEL=INFO
# Token do cabeçalho X-API-Token para coleta, regras e alertas (gere com: python -c "import secrets;print(secrets.token_urlsafe(32))")
API_TOKEN=

# Agendador (dias úteis, horário de Brasília)
AGENDADOR_ATIVO=true
HORARIOS_COLETA=13:30,18:00

# E-mail de alertas (opcional; sem SMTP_HOST os alertas vão só para o log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=monitor-cambio@localhost
